<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="neonOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF6A00" />
      <stop offset="100%" stop-color="#FF8A00" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <rect width="400" height="400" rx="40" fill="#121212"/>
  <circle cx="200" cy="200" r="160" fill="none" stroke="#262626" stroke-width="8"/>
  <circle cx="200" cy="200" r="150" fill="none" stroke="#FF6A00" stroke-width="4" filter="url(#glow)"/>
  
  <!-- Steaming Cup -->
  <path d="M 130 180 L 140 260 C 140 280 260 280 260 260 L 270 180 Z" fill="#1E1E1E" stroke="#FF6A00" stroke-width="6"/>
  <path d="M 270 195 C 300 195 300 245 270 245" fill="none" stroke="#00D4FF" stroke-width="6" stroke-linecap="round"/>
  
  <!-- Steam Curves -->
  <path d="M 170 160 C 160 140 180 120 170 100" fill="none" stroke="#FF6A00" stroke-width="4" stroke-linecap="round" filter="url(#glow)"/>
  <path d="M 200 165 C 190 145 210 125 200 105" fill="none" stroke="#8AFF5C" stroke-width="4" stroke-linecap="round" filter="url(#glow)"/>
  <path d="M 230 160 C 220 140 240 120 230 100" fill="none" stroke="#00D4FF" stroke-width="4" stroke-linecap="round" filter="url(#glow)"/>
  
  <!-- Text -->
  <text x="200" y="320" font-family="'Bebas Neue', 'Arial Black', sans-serif" font-size="32" font-weight="bold" fill="#FFFFFF" text-anchor="middle" letter-spacing="3">HOT N COOL</text>
  <text x="200" y="350" font-family="'Bebas Neue', 'Arial Black', sans-serif" font-size="24" fill="#FF6A00" text-anchor="middle" letter-spacing="6">CUPS</text>
</svg>
