<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#1E1E1E" />
      <stop offset="60%" stop-color="#121212" />
      <stop offset="100%" stop-color="#0A0A0A" />
    </radialGradient>
    <radialGradient id="neonOrangeGlow" cx="25%" cy="30%" r="40%">
      <stop offset="0%" stop-color="#FF6A00" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#FF6A00" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="neonCyanGlow" cx="75%" cy="40%" r="35%">
      <stop offset="0%" stop-color="#00D4FF" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#00D4FF" stop-opacity="0" />
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#262626" stroke-width="1" opacity="0.4"/>
    </pattern>
  </defs>
  <!-- Main Background -->
  <rect width="1920" height="1080" fill="url(#bgGrad)" />
  <rect width="1920" height="1080" fill="url(#grid)" />
  
  <!-- Neon Glow Orbs -->
  <rect width="1920" height="1080" fill="url(#neonOrangeGlow)" />
  <rect width="1920" height="1080" fill="url(#neonCyanGlow)" />

  <!-- Industrial Beams -->
  <line x1="0" y1="120" x2="1920" y2="120" stroke="#222" stroke-width="12" />
  <line x1="0" y1="130" x2="1920" y2="130" stroke="#FF6A00" stroke-width="2" opacity="0.6" />

  <!-- Hanging Edison Bulbs -->
  <line x1="300" y1="120" x2="300" y2="280" stroke="#444" stroke-width="2" />
  <circle cx="300" cy="290" r="12" fill="#FFB700" opacity="0.9" />
  <circle cx="300" cy="290" r="35" fill="#FF6A00" opacity="0.25" />

  <line x1="700" y1="120" x2="700" y2="220" stroke="#444" stroke-width="2" />
  <circle cx="700" cy="230" r="10" fill="#FFB700" opacity="0.9" />
  <circle cx="700" cy="230" r="30" fill="#FF6A00" opacity="0.2" />

  <line x1="1200" y1="120" x2="1200" y2="310" stroke="#444" stroke-width="2" />
  <circle cx="1200" cy="320" r="14" fill="#00D4FF" opacity="0.9" />
  <circle cx="1200" cy="320" r="40" fill="#00D4FF" opacity="0.25" />

  <!-- Neon Text Sign Silhouette -->
  <text x="960" y="240" font-family="'Bebas Neue', sans-serif" font-size="72" font-weight="bold" fill="none" stroke="#FF6A00" stroke-width="2" text-anchor="middle" opacity="0.3" letter-spacing="8">HOT N COOL CUPS</text>
</svg>
